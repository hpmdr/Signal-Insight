    <!-- RSRP 科普（新增强化版） -->
    <string name="metric_rsrp_label">RSRP</string>
    <string name="metric_rsrp_full">参考信号接收功率 (Reference Signal Received Power)</string>
    <string name="metric_rsrp_tip">RSRP 是衡量信号覆盖的最核心指标，信号强度的测量单位是 dBm。</string>
    <string name="rsrp_explain_title">什么是 RSRP？</string>
    <string name="rsrp_explain_basic">RSRP（参考信号接收功率）是手机测量基站发出的参考信号的功率值，是衡量 4G/5G 信号覆盖强度最核心的指标。单位是 dBm（分贝毫瓦），数值越接近 0 表示信号越强。5G NR 使用 SSB-RSRP，4G LTE 使用 CRS-RSRP，两者判定标准相近。按 3GPP 规范，RSRP 的报告范围约为 -156 ~ -44 dBm。</string>
    <string name="rsrp_range_title">RSRP 信号强度分级（业界常用经验值）</string>
    <string name="rsrp_range_excellent">极佳（优于 -85 dBm）</string>
    <string name="rsrp_range_excellent_desc">信号极强，可达峰值吞吐量，语音通话清晰，切换流畅</string>
    <string name="rsrp_range_good">良好（-85 ~ -95 dBm）</string>
    <string name="rsrp_range_good_desc">信号良好，高速数据传输稳定，日常体验流畅</string>
    <string name="rsrp_range_fair">一般（-95 ~ -105 dBm）</string>
    <string name="rsrp_range_fair_desc">信号中等，吞吐量开始下降，室内可能有衰减</string>
    <string name="rsrp_range_poor">较差（-105 ~ -115 dBm）</string>
    <string name="rsrp_range_poor_desc">信号较弱，吞吐量明显下降，延迟增加，可能掉线</string>
    <string name="rsrp_range_weak">极弱（弱于 -115 dBm）</string>
    <string name="rsrp_range_weak_desc">信号极弱，仅维持最低连接，可能无服务</string>
    <string name="rsrp_range_note">注：3GPP 只规定 RSRP 的报告范围与精度，并不规定「多少算好」。上表是业界常用的经验分级，不同厂商与运营商判定略有差异；本应用的评估与综合评分采用同一套阈值。</string>
    <string name="rsrp_factor_title">影响信号强度的因素</string>
    <string name="rsrp_factor_distance">与基站的距离：越远信号越弱</string>
    <string name="rsrp_factor_obstacle">建筑物遮挡：钢筋混凝土墙体衰减严重</string>
    <string name="rsrp_factor_weather">天气影响：大雨、大雾有轻微衰减</string>
    <string name="rsrp_factor_load">用户密度：基站负载高时信号会波动</string>
    <string name="rsrp_assessment_title">当前信号评估</string>
    <string name="rsrp_assessment_excellent">当前信号极佳！你处于基站近点，5G 可达峰值速率，时延最低。</string>
    <string name="rsrp_assessment_good">信号良好，日常使用体验流畅。如果感觉不理想，可尝试调整位置。</string>
    <string name="rsrp_assessment_fair">信号中等，网速可能下降。建议靠近窗户或到室外空旷处。</string>
    <string name="rsrp_assessment_poor">信号较弱。建议移动到窗户附近或室外，避开建筑物遮挡。</string>
    <string name="rsrp_assessment_weak">信号极弱，可能处于服务边缘或盲区。</string>
    <!-- 保留旧版 range 名称供 metricsDatabase 引用 -->

    <!-- RSRQ 科普（新增强化版） -->
    <string name="metric_rsrq_label">RSRQ</string>
    <string name="metric_rsrq_full">参考信号接收质量 (Reference Signal Received Quality)</string>
    <string name="metric_rsrq_tip">RSRQ 与 RSRP 结合使用才能全面评估信号状况。</string>
    <string name="rsrq_explain_title">什么是 RSRQ？</string>
    <string name="rsrq_explain_basic">RSRQ（参考信号接收质量）衡量的是信号有多「干净」。它的定义是 RSRQ = N × RSRP ÷ RSSI（N 为测量带宽内的资源块数量），因此数值恒为负值——RSSI 包含干扰与噪声，必然大于有用信号。即使 RSRP 显示信号很强，若环境干扰多或小区负载高，RSRQ 也会变差。单位是 dB。</string>
    <string name="rsrq_range_title">RSRQ 质量分级（业界常用经验值）</string>
    <string name="rsrq_range_good">优（优于 -10 dB）</string>
    <string name="rsrq_range_good_desc">信号纯净，小区负载低，体验极佳</string>
    <string name="rsrq_range_fair">中（-15 ~ -10 dB）</string>
    <string name="rsrq_range_fair_desc">有一定干扰或负载较高，整体可用</string>
    <string name="rsrq_range_poor">差（弱于 -15 dB）</string>
    <string name="rsrq_range_poor_desc">干扰较大或小区过载，网速不稳定，多出现在人群密集处</string>
    <string name="rsrq_range_note">注：RSRQ 的理论上限约为 -3 dB（单天线端口、空载、无干扰的理想情况），现实中几乎无法达到；单端口满载时典型值约 -10.8 dB，双端口空载/满载约 -6 dB / -13 dB。仅小区负载变化就能让 RSRQ 浮动 7~8 dB，因此同一位置不同时段的 RSRQ 差异属正常现象。3GPP 只规定其报告范围（约 -19.5 ~ -3 dB，0.5 dB 步进），不规定分级。</string>
    <string name="rsrq_joint_title">RSRP 与 RSRQ 联合判断</string>
    <string name="rsrq_joint_good_both">RSRP 强 + RSRQ 优 = 信号质量极佳！</string>
    <string name="rsrq_joint_good_both_desc">信号强度和纯净度都很好，这是最理想的网络状态。</string>
    <string name="rsrq_joint_strong_noise">RSRP 强 + RSRQ 差 = 干扰大</string>
    <string name="rsrq_joint_strong_noise_desc">虽然信号强度够，但环境干扰大。多发生在人群密集的车站、商场等地方。</string>
    <string name="rsrq_joint_weak_both">RSRP 弱 + RSRQ 差 = 信号差</string>
    <string name="rsrq_joint_weak_both_desc">信号强度和纯净度都差，建议移动到室外或靠近窗户处。</string>
    <string name="rsrq_assessment_title">当前信号质量评估</string>
    <string name="rsrq_assessment_good">信号纯净度高，干扰少，体验很好。</string>
    <string name="rsrq_assessment_fair">存在一定干扰，但如果 RSRP 信号强，体验仍然可以接受。</string>
    <string name="rsrq_assessment_poor">干扰较大。建议远离人群密集区域或大型电子设备。</string>

    <!-- SINR 科普（新增强化版） -->
    <string name="metric_sinr_label">SINR</string>
    <string name="metric_sinr_full">信干噪比 (Signal to Interference plus Noise Ratio)</string>
    <string name="metric_sinr_tip">SINR 是影响实际网速的关键指标，比 RSRP 更能反映真实体验。</string>
    <string name="sinr_explain_title">什么是 SINR？</string>
    <string name="sinr_explain_basic">SINR（信干噪比）是有用信号与干扰加噪声的比值。可以想象在嘈杂的房间里听人说话——信号是说话声，噪声和旁人交谈是干扰。SINR 越高，你听得越清楚，网速通常也越快。单位是 dB。注意它与单纯的 SNR（信噪比）不同：SINR 把邻区干扰也算了进去，因此更能反映真实体验。</string>
    <string name="sinr_range_title">SINR 与下载速度的参考关系</string>
    <string name="sinr_range_excellent">极速（优于 20 dB）</string>
    <string name="sinr_range_excellent_speed">5G: 500~800Mbps+ / 4G: 80~100Mbps+，通常可支持 256QAM</string>
    <string name="sinr_range_good">流畅（10 ~ 20 dB）</string>
    <string name="sinr_range_good_speed">5G: 300~500Mbps / 4G: 50~80Mbps，通常可支持 64QAM</string>
    <string name="sinr_range_fair">一般（5 ~ 10 dB）</string>
    <string name="sinr_range_fair_speed">5G: 30~250Mbps / 4G: 10~50Mbps，通常为 16QAM</string>
    <string name="sinr_range_poor">较差（0 ~ 5 dB）</string>
    <string name="sinr_range_poor_speed">5G: 5~30Mbps / 4G: &lt; 10Mbps，通常回落至 QPSK，延迟升高</string>
    <string name="sinr_range_weak">卡顿（弱于 0 dB）</string>
    <string name="sinr_range_weak_speed">信号接近被噪声淹没，频繁重传，可能无法维持连接</string>
    <string name="sinr_range_note">注：实际速率并非只由 SINR 决定。3GPP 未规定 SINR 到速率的换算关系，各芯片厂商依据自身实测建立映射；真实速率还受带宽、MIMO 层数、调度策略、网络拥塞与终端能力影响。调制方式与 SINR 之间也不是一一对应。上表仅供定性参考。</string>
    <string name="sinr_factor_title">影响 SINR 的因素</string>
    <string name="sinr_factor_location">距离基站越近，信号越强，SINR 越高</string>
    <string name="sinr_factor_crowd">人群密集导致干扰增加，SINR 下降</string>
    <string name="sinr_factor_handover">基站交界处切换频繁，SINR 可能波动</string>
    <string name="sinr_assessment_title">当前 SINR 评估</string>
    <string name="sinr_assessment_excellent">SINR 极佳！5G 可达 500Mbps+，4G 可达 80Mbps+，调制最高效。</string>
    <string name="sinr_assessment_good">SINR 良好，5G 可达 300~500Mbps，日常使用无压力。</string>
    <string name="sinr_assessment_fair">SINR 中等，5G 约 30~250Mbps，看视频正常但大文件下载较慢。</string>
    <string name="sinr_assessment_poor">SINR 较差，5G 低于 30Mbps，建议走到开阔处改善信号环境。</string>
    <string name="sinr_assessment_weak">SINR 极差，信号几乎被噪声淹没，建议移动到信号更好的位置。</string>
    <!-- 保留旧版 range 名称供 metricsDatabase 引用 -->

    <!-- RSSI 科普（新增强化版） -->
    <string name="metric_rssi_label">RSSI</string>
    <string name="metric_rssi_full">接收信号强度指示</string>
    <string name="metric_rssi_tip">RSSI 测的是所有信号的总和，RSRP 只测有用信号。</string>
    <string name="rssi_explain_title">什么是 RSSI？</string>
    <string name="rssi_explain_basic">RSSI（接收信号强度指示）是手机在整个测量带宽内接收到的总功率，包括服务小区、同频邻区、邻道干扰以及热噪声。它是一个比 RSRP 更宽泛的指标。单位是 dBm。注意：RSRP 是「每个资源粒子」的功率，而 RSSI 是「整个带宽」的总功率，两者量纲不同，不能直接比较——RSSI 天然比 RSRP 高约 25~35 dB（取决于带宽）。</string>
    <string name="rssi_vs_rsrp_title">RSSI 与 RSRP 的关系</string>
    <string name="rssi_vs_rsrp_large">差值明显大于带宽理论值 = 干扰偏大</string>
    <string name="rssi_vs_rsrp_large_desc">RSSI 与 RSRP 的差值主要来自带宽（如 20MHz 约差 31 dB）。若实际差值明显超出该理论值，说明存在较强干扰。</string>
    <string name="rssi_vs_rsrp_small">差值接近带宽理论值 = 干扰较小</string>
    <string name="rssi_vs_rsrp_small_desc">此时接收功率主要来自有用信号，环境相对干净。</string>
    <string name="rssi_vs_rsrp_load">一个重要特性：RSSI 随小区负载上升</string>
    <string name="rssi_vs_rsrp_load_desc">即使无线链路本身没有变化，只要小区内用户变多、发射功率增大，RSSI 就会升高。因此 RSSI 偏高并不一定代表信号更好。</string>
    <string name="rssi_when_use_title">什么时候参考 RSSI？</string>
    <string name="rssi_when_use_wifi">Wi-Fi 网络：RSSI 是 Wi-Fi 信号的主要指标</string>
    <string name="rssi_when_use_2g">2G/GSM 网络：RSSI 更常用</string>
    <string name="rssi_when_use_proximity">信号快速检查：粗略判断是否靠近基站</string>
    <string name="rssi_assessment_title">当前 RSSI 评估</string>
    <string name="rssi_assessment_good">信号水平在正常范围内。</string>
    <string name="rssi_assessment_fair">有信号但可能存在干扰。</string>
    <string name="rssi_assessment_poor">信号偏低。请确认你处于覆盖良好的区域。</string>

    <!-- Band 科普（新增强化版） -->
    <string name="metric_band_label">Band</string>
    <string name="metric_band_full">工作频段 (Frequency Band)</string>
    <string name="metric_band_tip_5g_high">n78/n79 是目前最主流的 5G 高速频段，网速极快但穿透力较弱，室外使用体验最佳。</string>
    <string name="metric_band_tip_5g_mid">n41 是 5G 主力频段，兼顾覆盖与速度，是国内 5G 网络的核心频段。</string>
    <string name="metric_band_tip_lte_mid">B1/B3/B39/B40/B41 是 4G 主力频段，覆盖广、速率均衡，是目前移动网络的中坚力量。</string>
    <string name="metric_band_tip_low">%s 属于低频段，信号覆盖广、穿墙能力强，但网速相对较慢，适合室内和远距离场景。</string>
    <string name="band_explain_title">什么是频段？</string>
    <string name="band_explain_basic">频段是无线通信中划分出来的特定频率范围，就像高速公路上的不同车道。每个频段都有自己独特的特性：频率高低决定了信号的覆盖范围、穿透能力和传输速度。</string>
    <string name="band_current_title">当前连接频段</string>
    <string name="band_type_low">低频段（支持 4G/5G）</string>
    <string name="band_type_mid">中频段（支持 4G/5G）</string>
    <string name="band_type_high">高频段（支持 5G）</string>
